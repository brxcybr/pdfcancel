# pdfcancel skill profile: copy to ~/.config/pdfcancel/skill.env and edit.
# Sourced by scripts/pdfcancel-skill.sh. Keep it out of version control.

# Virtualenv that has pdfcancel installed with the [vlm] extra
# (install.sh creates one here by default).
PDFCANCEL_VENV="$HOME/.local/share/pdfcancel/venv"

# OpenAI-compatible endpoint: a LiteLLM proxy (one URL, many models) or a
# single vLLM / Ollama server. A trailing /v1 is optional.
PDFCANCEL_API_BASE="https://your-host/litellm/v1"

# Bearer token. vLLM accepts any value; a LiteLLM gateway may need a real key.
PDFCANCEL_API_KEY="EMPTY"

# OCR model and (optional) figure-description model. LiteLLM aliases or
# backend Hugging Face ids both work; run `pdfcancel-skill.sh check` to list them.
PDFCANCEL_VLM_MODEL="your-ocr-vision-model"
PDFCANCEL_VLM_FULL_MODEL=""

# PEM bundle for an internal CA (root + issuing). Leave empty for public CAs.
PDFCANCEL_CA_BUNDLE=""

# Where install.sh and `pdfcancel-skill.sh update` get pdfcancel and the skill.
# PDFCANCEL_REPO="https://github.com/brxcybr/pdfcancel"
# PDFCANCEL_REF="main"

# Optional tuning (pdfcancel defaults shown).
# PDFCANCEL_OCR_DPI=200
# PDFCANCEL_FIGURE_DPI=200
# PDFCANCEL_VLM_TEXT_LAYER=1   # 0: don't give the model born-digital pages' text
# PDFCANCEL_OCR_CONCURRENCY=4
# PDFCANCEL_CHUNKER=hierarchical
